diff --git a/crates/plannotator-tui/src/agent_choices.rs b/crates/plannotator-tui/src/agent_choices.rs
new file mode 100644
index 0000000..32b1e92
--- /dev/null
+++ b/crates/plannotator-tui/src/agent_choices.rs
@@ -0,0 +1,60 @@
+//! Join live agents to their tab labels within the invoking workspace, across all of its tabs.
+use crate::delivery::AgentChoice;
+use anyhow::{Context as _, Result};
+use serde_json::Value;
+
+pub(crate) fn parse(agents: &Value, tabs: &Value, workspace: &str) -> Result<Vec<AgentChoice>> {
+    let agents = agents.pointer("/result/agents").and_then(Value::as_array).context("missing agent list")?;
+    let tabs = tabs.pointer("/result/tabs").and_then(Value::as_array).context("missing tab list")?;
+    let mut choices = Vec::new();
+    for agent in agents {
+        if agent.get("workspace_id").and_then(Value::as_str) != Some(workspace) {
+            continue;
+        }
+        let (Some(pane), Some(kind), Some(tab_id)) = (
+            agent.get("pane_id").and_then(Value::as_str),
+            agent.get("agent").and_then(Value::as_str),
+            agent.get("tab_id").and_then(Value::as_str),
+        ) else {
+            continue;
+        };
+        let tab = tabs.iter().find(|tab| tab.get("tab_id").and_then(Value::as_str) == Some(tab_id));
+        let label = tab
+            .and_then(|tab| tab.get("label"))
+            .and_then(Value::as_str)
+            .filter(|s| !s.is_empty())
+            .unwrap_or(tab_id);
+        let name = agent.get("name").and_then(Value::as_str).unwrap_or(kind);
+        choices.push(AgentChoice {
+            pane: pane.to_owned(),
+            agent: kind.to_owned(),
+            label: format!("{label} · {name} ({pane})"),
+        });
+    }
+    choices.sort_by(|a, b| a.label.cmp(&b.label));
+    choices.dedup_by(|a, b| a.pane == b.pane);
+    Ok(choices)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn other_tabs_are_selectable_and_labels_disambiguate_agents() -> Result<()> {
+        let agents = json!({"result":{"agents":[
+            {"workspace_id":"w1","pane_id":"w1:p1","agent":"codex","tab_id":"w1:t1"},
+            {"workspace_id":"w1","pane_id":"w1:p2","agent":"codex","name":"reviewer","tab_id":"w1:t2"},
+            {"workspace_id":"w2","pane_id":"w2:p1","agent":"claude","tab_id":"w2:t1"}
+        ]}});
+        let tabs = json!({"result":{"tabs":[{"tab_id":"w1:t1","label":"Frontend"},{"tab_id":"w1:t2","label":"Backend"}]}});
+        let choices = parse(&agents, &tabs, "w1")?;
+        assert_eq!(choices.len(), 2);
+        assert!(parse(&agents, &tabs, "unknown-workspace")?.is_empty());
+        assert!(choices.iter().any(|c| c.label == "Backend · reviewer (w1:p2)"));
+        assert!(choices.iter().any(|c| c.label == "Frontend · codex (w1:p1)"));
+        assert!(!choices.iter().any(|c| c.pane == "w2:p1"));
+        assert!(parse(&json!({}), &tabs, "w1").is_err());
+        Ok(())
+    }
+}
diff --git a/crates/plannotator-tui/src/app/agents.rs b/crates/plannotator-tui/src/app/agents.rs
new file mode 100644
index 0000000..0dccd6d
--- /dev/null
+++ b/crates/plannotator-tui/src/app/agents.rs
@@ -0,0 +1,127 @@
+//! Explicit recipient selection. Refresh on every open and retain only live selections.
+use super::{App, Mode};
+use crate::theme::palette;
+use ratatui::Frame;
+use ratatui::crossterm::event::{KeyCode, KeyEvent, KeyModifiers, MouseButton, MouseEvent, MouseEventKind};
+use ratatui::layout::Rect;
+use ratatui::style::{Color, Style};
+use ratatui::text::{Line, Span};
+use ratatui::widgets::{Block, BorderType, Borders, Clear, Paragraph};
+use unicode_width::UnicodeWidthStr as _;
+
+impl App {
+    pub(super) fn open_agents(&mut self) {
+        if let Err(err) = self.delivery.refresh_agents(false) {
+            self.status = Some(format!("cannot list agents: {err:#}"));
+        }
+        self.agents_cursor = self
+            .delivery
+            .agent_choices()
+            .and_then(|choices| {
+                choices.iter().position(|c| Some(c.pane.as_str()) == self.delivery.selected_pane())
+            })
+            .unwrap_or(0);
+        self.mode = Mode::Agents;
+    }
+
+    fn choose_agent(&mut self, index: usize) {
+        let pane =
+            self.delivery.agent_choices().and_then(|choices| choices.get(index)).map(|c| c.pane.clone());
+        if let Some(pane) = pane {
+            let selected =
+                if self.delivery.selected_pane() == Some(pane.as_str()) { None } else { Some(pane) };
+            self.delivery.select_agent(selected);
+            self.derive_send_state();
+            self.status = Some(if self.delivery.can_send() {
+                format!("send to {}", self.delivery.describe())
+            } else {
+                "select an agent before sending".into()
+            });
+            self.mode = Mode::Browse;
+        }
+    }
+
+    pub(super) fn agents_key(&mut self, key: KeyEvent) {
+        let last = self.delivery.agent_choices().map_or(0, |choices| choices.len().saturating_sub(1));
+        match key.code {
+            KeyCode::Down | KeyCode::Char('j') => self.agents_cursor = (self.agents_cursor + 1).min(last),
+            KeyCode::Up | KeyCode::Char('k') => self.agents_cursor = self.agents_cursor.saturating_sub(1),
+            KeyCode::Enter | KeyCode::Char(' ') => self.choose_agent(self.agents_cursor),
+            KeyCode::Esc | KeyCode::Char('A') => self.mode = Mode::Browse,
+            KeyCode::Char('c') if key.modifiers == KeyModifiers::CONTROL => self.mode = Mode::Browse,
+            _ => {}
+        }
+    }
+
+    pub(super) fn agents_mouse(&mut self, mouse: MouseEvent) {
+        match mouse.kind {
+            MouseEventKind::ScrollDown => self.agents_key(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE)),
+            MouseEventKind::ScrollUp => self.agents_key(KeyEvent::new(KeyCode::Up, KeyModifiers::NONE)),
+            MouseEventKind::Down(MouseButton::Left) => {
+                let inside = |r: Rect| {
+                    mouse.column >= r.x
+                        && mouse.column < r.right()
+                        && mouse.row >= r.y
+                        && mouse.row < r.bottom()
+                };
+                if let Some(index) =
+                    self.geometry.agents_rows.iter().find(|(r, _)| inside(*r)).map(|(_, i)| *i)
+                {
+                    self.choose_agent(index);
+                } else if !self.geometry.agents_menu.is_some_and(inside) {
+                    self.mode = Mode::Browse;
+                }
+            }
+            _ => {}
+        }
+    }
+
+    pub(super) fn draw_agents(&mut self, frame: &mut Frame) {
+        let area = frame.area();
+        let choices = self.delivery.agent_choices().unwrap_or(&[]);
+        let width =
+            (choices.iter().map(|c| c.label.width() + 8).max().unwrap_or(32) as u16).max(48).min(area.width);
+        let height = (choices.len().max(1) as u16 + 2).min(area.height);
+        let button = self.geometry.agents_button;
+        let rect = Rect {
+            x: button.map_or(area.right(), Rect::right).saturating_sub(width).max(area.x),
+            y: button.map_or(area.y, Rect::bottom).min(area.bottom().saturating_sub(height)),
+            width,
+            height,
+        };
+        frame.render_widget(Clear, rect);
+        let block = Block::default()
+            .borders(Borders::ALL)
+            .border_type(BorderType::Rounded)
+            .border_style(Style::new().fg(Color::Cyan))
+            .title(" choose agent ")
+            .title_bottom(" ↑↓ move · enter/space select · esc close ");
+        let inner = block.inner(rect);
+        frame.render_widget(block, rect);
+        self.geometry.agents_menu = Some(rect);
+        let visible = usize::from(inner.height);
+        let start = self.agents_cursor.saturating_sub(visible.saturating_sub(1));
+        let lines: Vec<Line<'static>> = choices
+            .iter()
+            .enumerate()
+            .skip(start)
+            .take(visible)
+            .map(|(index, choice)| {
+                let y = inner.y + (index - start) as u16;
+                self.geometry.agents_rows.push((Rect { y, height: 1, ..inner }, index));
+                let check =
+                    if self.delivery.selected_pane() == Some(choice.pane.as_str()) { "x" } else { " " };
+                let style = if index == self.agents_cursor { palette().selection } else { Style::new() };
+                Line::from(Span::styled(format!(" [{check}] {}", choice.label), style))
+            })
+            .collect();
+        frame.render_widget(
+            Paragraph::new(if choices.is_empty() {
+                vec![Line::from(" No live agents available")]
+            } else {
+                lines
+            }),
+            inner,
+        );
+    }
+}
diff --git a/crates/plannotator-tui/src/app/agents_tests.rs b/crates/plannotator-tui/src/app/agents_tests.rs
new file mode 100644
index 0000000..5e4c711
--- /dev/null
+++ b/crates/plannotator-tui/src/app/agents_tests.rs
@@ -0,0 +1,83 @@
+#![cfg(unix)]
+#![allow(clippy::expect_used, reason = "tests assert by panicking")]
+use super::Mode;
+use super::review_test_support::{draw, file_app, press};
+use crate::delivery::{Delivery, HerdrAgent};
+use plannotator_tui_schema::Kind;
+use ratatui::crossterm::event::{
+    Event, KeyCode, KeyEvent, KeyModifiers, MouseButton, MouseEvent, MouseEventKind,
+};
+use serde_json::json;
+use std::os::unix::fs::PermissionsExt as _;
+
+#[test]
+fn multiple_agents_require_selection_for_mouse_send_resend_and_send_quit() {
+    let (root, mut app, _) = file_app("agent-selection");
+    let bin = root.join("herdr-fake");
+    let script = r#"#!/usr/bin/env sh
+cd "$(dirname "$0")" || exit 1
+case "$1 $2" in
+  'agent list') cat agents.json ;;
+  'tab list') cat tabs.json ;;
+  'agent prompt') printf '%s\n' "$3" >> prompts ;;
+  *) exit 1 ;;
+esac
+"#;
+    std::fs::write(&bin, script).expect("fake CLI");
+    std::fs::set_permissions(&bin, std::fs::Permissions::from_mode(0o700)).expect("executable");
+    let agents = json!({"result":{"agents":[{"workspace_id":"w1","pane_id":"w1:p1","agent":"codex","tab_id":"w1:t1"},{"workspace_id":"w1","pane_id":"w1:p2","agent":"claude","tab_id":"w1:t2"},{"workspace_id":"w2","pane_id":"w2:p1","agent":"claude","tab_id":"w2:t1"}]}});
+    std::fs::write(root.join("agents.json"), agents.to_string()).expect("agents");
+    std::fs::write(root.join("tabs.json"), json!({"result":{"tabs":[{"tab_id":"w1:t1","label":"Frontend"},{"tab_id":"w1:t2","label":"Backend"}]}}).to_string()).expect("tabs");
+    let mut delivery = HerdrAgent::new(bin, "w1:p1".into(), Some("codex".into()));
+    delivery.refresh_agents(true).expect("discovery");
+    assert!(!delivery.can_send(), "invoking agent is not preselected");
+    app.delivery = Box::new(delivery);
+    app.add_quote_annotation("one", Kind::Comment, "feedback".into()).expect("note");
+    for key in ['E', 'R'] {
+        press(&mut app, key);
+    }
+    app.send_and_quit().expect("S path");
+    assert!(!app.quit);
+    draw(&mut app, 100, 20);
+    let rect = app.geometry.send_button.expect("button");
+    app.handle_event(&Event::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: rect.x,
+        row: rect.y,
+        modifiers: KeyModifiers::NONE,
+    }))
+    .expect("click");
+    assert!(!root.join("prompts").exists());
+    assert_eq!(app.send_count(), 1, "feedback remains pending");
+    app.open_agents();
+    let rows = draw(&mut app, 100, 20);
+    assert!(rows.contains("[ ] Backend · claude (w1:p2)"));
+    assert!(rows.contains("[ ] Frontend · codex (w1:p1)"));
+    assert!(!rows.contains("w2:p1"), "other workspaces are hidden");
+    app.delivery.select_agent(Some("w2:p1".into()));
+    assert!(!app.delivery.can_send(), "other workspaces cannot be selected");
+    app.agents_key(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+    assert_eq!(app.mode, Mode::Browse);
+    assert_eq!(app.delivery.selected_pane(), Some("w1:p2"));
+    press(&mut app, 'E');
+    assert_eq!(std::fs::read_to_string(root.join("prompts")).expect("send"), "w1:p2\n");
+    assert_eq!(app.send_count(), 0);
+    app.open_agents();
+    app.agents_key(KeyEvent::new(KeyCode::Char(' '), KeyModifiers::NONE));
+    assert!(!app.delivery.can_send(), "clicking checked agent deselects it");
+    app.delivery.select_agent(Some("w1:p2".into()));
+    std::fs::write(root.join("agents.json"), "{\"result\":{\"agents\":[]}}").expect("agents exited");
+    app.open_agents();
+    assert!(!app.delivery.can_send(), "removed target is cleared");
+    std::fs::write(
+        root.join("agents.json"),
+        json!({"result":{"agents":[{"workspace_id":"w1","pane_id":"w1:p1","agent":"codex","tab_id":"w1:t1"}]}}).to_string(),
+    )
+    .expect("single agent");
+    app.delivery.refresh_agents(true).expect("single discovery");
+    assert_eq!(app.delivery.selected_pane(), Some("w1:p1"));
+    std::fs::write(root.join("agents.json"), "invalid JSON").expect("failed discovery");
+    assert!(app.delivery.refresh_agents(false).is_err());
+    assert!(!app.delivery.can_send(), "discovery failure clears selection");
+    std::fs::remove_dir_all(root).expect("cleanup");
+}
